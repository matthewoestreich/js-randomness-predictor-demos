{
  "name": "js-randomness-predictor-demos",
  "version": "1.0.0",
  "description": "Demos and examples for js-randomness-predictor",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "printWidth": 150
  },
  "scripts": {
    "format": "prettier --write . '!./docs' '!./_archives'",
    "build": "node npm.build.js",
    "build:dev": "DEV=1 node npm.build.js",
    "gh:push": "npm run format && npm run build && git add . && git commit -m \"update\" && git push origin main",
    "dev": "node server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
